# AtlasAgent course environment variables

# Public gateway port used by Nginx in Docker Compose.
NGINX_PORT=8088
NGINX_HOST=127.0.0.1

# UI service defaults.
UI_API_PROXY_URL=http://api:8000/api/:path*

# API service defaults.
API_APP_NAME=AtlasAgent API
API_ENV=development
API_VERSION=0.1.0
API_PREFIX=/api
API_AUTH_ENABLED=true
# scripts/start.sh replaces this placeholder with a random 256-bit key.
ATLAS_API_KEY=change-me
LOG_LEVEL=INFO
RUN_MIGRATIONS=true
LLM_CONFIG_PATH=runtime-config/llm.yaml
MCP_CONFIG_PATH=runtime-config/mcp.yaml
A2A_CONFIG_PATH=runtime-config/a2a.yaml
MODULE_CONFIG_PATH=runtime-config/modules.yaml
MCP_STDIO_ENABLED=false
# Exact command-and-arguments signatures, for example ["uvx qiniu-mcp-server"].
MCP_STDIO_ALLOWED_COMMANDS=[]
MCP_HTTP_ALLOWED_HOSTS=[]
A2A_HTTP_ALLOWED_HOSTS=[]
CORS_ALLOW_ORIGINS=["http://localhost:8088","http://127.0.0.1:8088","http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
FILE_STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
ARTIFACT_DIR=/app/artifacts
TOOL_OUTPUT_INLINE_LIMIT=65536
TOOL_DEFAULT_TIMEOUT_SECONDS=30
TOOL_AUTO_APPROVE_RISK=medium
MAX_UPLOAD_SIZE=10485760
MAX_FILE_PREVIEW_SIZE=65536
SANDBOX_API_BASE_URL=http://sandbox:8100/api
SANDBOX_API_TIMEOUT_SECONDS=30
SANDBOX_SHELL_WAIT_TIMEOUT_SECONDS=10
DOCKER_SANDBOX_ID=default
DOCKER_SANDBOX_NAME=atlas-sandbox
DOCKER_SANDBOX_WAIT_RETRIES=10
DOCKER_SANDBOX_WAIT_INTERVAL_SECONDS=1
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com
BING_SEARCH_MARKET=zh-CN
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RESULTS=5

# PostgreSQL defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas_agents
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/atlas_agents

# Redis defaults.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
AGENT_TASK_STREAM=agent:tasks
# Task queue backend: redis (multi-replica deployments) or local
# (single machine, persisted to SQLite; no Redis required).
# scripts/quickstart.py sets this to local.
AGENT_TASK_BACKEND=redis
AGENT_TASK_LOCAL_PATH=var/agent-tasks.db
AGENT_TASK_CONSUMER_GROUP=atlas-agent-runners
AGENT_TASK_CLAIM_IDLE_MS=30000
AGENT_TASK_MAX_CONCURRENCY=4
AGENT_TASK_POLL_TIMEOUT_MS=1000

# Context engineering defaults.
CONTEXT_MESSAGE_LIMIT=8
CONTEXT_EVENT_LIMIT=20
CONTEXT_MAX_MESSAGE_CHARS=1200
CONTEXT_MEMORY_CANDIDATE_LIMIT=100
CONTEXT_MEMORY_LIMIT=6
CONTEXT_MEMORY_MAX_CHARS=2400
CONTEXT_MEMORY_ITEM_MAX_CHARS=500
CONTEXT_MEMORY_MIN_SCORE=0.12

# Sandbox service defaults.
SANDBOX_APP_NAME=AtlasAgent Sandbox
SANDBOX_ENV=development
SANDBOX_VERSION=0.1.0
SANDBOX_API_PREFIX=/api
SANDBOX_AUTH_ENABLED=true
SANDBOX_WORKSPACE_DIR=/workspace
SANDBOX_MAX_FILE_READ_BYTES=65536
SANDBOX_MAX_FILE_WRITE_BYTES=524288
SANDBOX_MAX_UPLOAD_SIZE=10485760
SANDBOX_SHELL_OUTPUT_LIMIT=65536
SANDBOX_SHELL_DEFAULT_TIMEOUT_SECONDS=10
SANDBOX_BROWSER_ENABLED=true
SANDBOX_BROWSER_HEADLESS=false
SANDBOX_BROWSER_VIEWPORT_WIDTH=1280
SANDBOX_BROWSER_VIEWPORT_HEIGHT=720
SANDBOX_BROWSER_DEFAULT_TIMEOUT_MS=15000
SANDBOX_BROWSER_SCREENSHOT_FULL_PAGE=true
SANDBOX_VNC_ENABLED=true
SANDBOX_VNC_DISPLAY=:99
SANDBOX_VNC_PORT=5900
SANDBOX_VNC_WEB_PORT=6080
SANDBOX_VNC_IFRAME_PATH=
SUPERVISOR_ENABLED=false
SUPERVISOR_SERVICES=["sandbox-api","xvfb","x11vnc","websockify"]

# RAG retrieval-augmented generation defaults.
# Vector backend: auto (pick pgvector on PostgreSQL, portable SQL elsewhere),
# pgvector (reuses PostgreSQL), qdrant (separate service), or sql
# (dialect-neutral, cosine similarity in the application layer).
RAG_VECTOR_BACKEND=auto
# Embedding provider: auto (use llm.yaml embedding config when its key exists)
# or local_hash (deterministic offline vectors, no external service).
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_DIM=256
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_CANDIDATE_LIMIT=24
RAG_MIN_SCORE=0.15
RAG_MAX_CONTEXT_CHARS=3600
RAG_MAX_DOCUMENT_CHARS=200000
# Only used when RAG_VECTOR_BACKEND=qdrant (docker compose --profile qdrant up -d).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10

# Skill registry context injection budgets.
CONTEXT_SKILL_LIMIT=3
CONTEXT_SKILL_MAX_CHARS=2000
CONTEXT_SKILL_MIN_SCORE=0.1

# LLM provider. Fill this in when the LLM chapter introduces model calls.
LLM_API_KEY=
# OpenAI-compatible embedding service key. Leave empty to fall back to
# deterministic local hashing vectors (offline teaching mode).
EMBEDDING_API_KEY=
